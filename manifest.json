{
  "manifest_version": 3,
  "name": "Merchant Scroll",
  "version": "1.2.1",
  "key": "",
  "description": "Quickly check MTG card prices at major Canadian retailers. Companion to MTG Wishboard.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://store.401games.ca/*",
    "https://facetofacegames.com/*",
    "https://emmettstoystop.com/*",
    "https://hobbiesville.com/*",
    "*://*.moxfield.com/*",
    "https://mtgwishboard.vercel.app/*",
    "http://localhost:5173/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.moxfield.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://mtgwishboard.ca/*",
      "https://mtgwishboard.vercel.app/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "setnames.json",
        "popup.html"
      ],
      "matches": [
        "*://*.moxfield.com/*"
      ]
    }
  ]
}